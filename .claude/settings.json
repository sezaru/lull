{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter build:*)",
      "Bash(flutter run:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart pub get:*)",
      "Bash(dart pub global activate:*)",
      "Bash(curl:*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "ast-grep@ast-grep-marketplace": true,
    "frontend-design@claude-code-plugins": true,
    "context-mode@context-mode": true,
    "caveman@caveman": true,
    "mempalace@mempalace": true,
    "dart-flutter@dart-flutter": true,
    "ui-design@dev-ai-plugins": true,
    "mobile-dev@dev-ai-plugins": true,
    "coding-guidelines@dev-ai-plugins": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    },
    "claude-code-plugin": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "mempalace": {
      "source": {
        "source": "github",
        "repo": "mempalace/mempalace"
      }
    },
    "flutter-skills": {
      "source": {
        "source": "github",
        "repo": "flutter/skills"
      }
    },
    "dev-ai-plugins": {
      "source": {
        "source": "github",
        "repo": "hexhound/dev-ai-plugins"
      }
    }
  },
  "enableAllProjectMcpServers": true
}
